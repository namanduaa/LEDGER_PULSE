# Copy to .env and fill in. Never commit .env.
SECRET_KEY=change-me-generate-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Asia/Kolkata
# Currency symbol shown on amounts (the mockups use $; use ₹ if you prefer)
CURRENCY_SYMBOL=$

# PostgreSQL (docker compose up -d db starts one on port 5433)
DB_NAME=ledgerpulse
DB_USER=ledgerpulse
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5433
